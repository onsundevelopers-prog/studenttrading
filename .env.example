# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# NEVER prefix a secret key with NEXT_PUBLIC_ — anything NEXT_PUBLIC_ ships to
# the browser bundle.
# ---------------------------------------------------------------------------

# Supabase project URL (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — SERVER ONLY. Bypasses Row Level Security.
# Used exclusively for auth administration (provisioning student accounts) and
# privileged server-side writes. Never import this into a client component.
SUPABASE_SECRET_KEY=

# Finnhub market data key — SERVER ONLY. Never exposed to the browser;
# all market data flows through /src/lib/market.
FINNHUB_API_KEY=

# Shared secret for the /api/cron/* endpoints (price + portfolio sampling).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Domain used to synthesise internal, non-deliverable emails for student
# accounts. Students sign in with their handle (e.g. "jsmith"), not this address.
STUDENT_EMAIL_DOMAIN=students.classroom-trading.local

# Alpaca market data + paper trading — SERVER ONLY. Never exposed to the
# browser; all Alpaca traffic flows through /src/lib/market/alpaca.ts.
# ALPACA_PAPER must stay true: this product only ever uses the paper endpoint.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Teacher invite codes — comma-separated. When set, creating a teacher account
# requires one of these codes on the signup form. Leave unset to allow open
# teacher signup (fine for local development).
TEACHER_INVITE_CODES=

# Alpha Vantage — financial news and news sentiment. SERVER ONLY. Never exposed
# to the browser; all Alpha Vantage traffic flows through /src/lib/news.
# Get a key at https://www.alphavantage.co/support/#api-key
# NOTE: this provider takes the key as a URL query parameter, so the app never
# logs or returns a request URL that contains it.
ALPHA_VANTAGE_API_KEY=

# Ceiling on Alpha Vantage calls per UTC day, shared by every classroom.
# The free tier allows 25/day in total, so the app serves cache once the budget
# is spent instead of letting one class exhaust the key. Raise it on a paid plan.
# Defaults to 20 when unset.
ALPHA_VANTAGE_DAILY_BUDGET=20
